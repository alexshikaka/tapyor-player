{
  "name": "stream-player",
  "version": "0.8.0",
  "description": "Тапёр — музыка и заказы для стрима из нескольких сервисов",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always"
  },
  "author": "shikaka",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "yt-search": "^2.10.4",
    "@distube/ytdl-core": "^4.16.4"
  },
  "build": {
    "appId": "app.shikaka.streamplayer",
    "productName": "Тапёр",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      { "from": "resources/yt-dlp.exe", "to": "yt-dlp.exe" }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shikaka068091",
        "repo": "stream-player",
        "releaseType": "release"
      }
    ]
  }
}
