{
  "name": "tapyor",
  "version": "0.18.0",
  "description": "Тапёр — музыка и заказы для стрима из нескольких сервисов",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always",
    "audit:skins": "node tests/skins/audit.js"
  },
  "author": "shikaka",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "yt-search": "^2.10.4",
    "@distube/ytdl-core": "^4.16.4"
  },
  "build": {
    "appId": "app.alexshikaka.tapyor",
    "productName": "Тапёр",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Тапёр"
    },
    "extraResources": [
      {
        "from": "resources/yt-dlp.exe",
        "to": "yt-dlp.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "alexshikaka",
        "repo": "tapyor-player",
        "releaseType": "release"
      }
    ],
    "artifactName": "Tapyor-Setup-${version}.${ext}"
  }
}
